# Copy to .env.local and fill in at least one provider.
# Models offered in the picker, first is the default: provider:model-id[=Label], comma-separated.
# Entries whose provider has no credentials are hidden automatically.
LENS_MODELS=anthropic:claude-sonnet-5-5=Claude Sonnet 5.5,openai:gpt-6.1-sol=GPT-6.1 Sol,google:gemini-3.8-flash=Gemini 3.8 Flash,local:llama3.3=Llama 3.3 (local)

# Provider credentials (set only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Vercel AI Gateway: one key for many providers; ids look like gateway:anthropic/claude-sonnet-5.5
AI_GATEWAY_API_KEY=
# Any OpenAI-compatible server: Ollama (http://localhost:11434/v1), vLLM, LM Studio, Groq, Together, OpenRouter…
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# Optional: require a shared access code before anyone can chat (protects your API spend).
LENS_ACCESS_CODE=
